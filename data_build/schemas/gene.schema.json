{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CircaDB Gene",
  "type": "object",
  "required": [
    "id",
    "symbol",
    "name",
    "aliases",
    "species",
    "external_ids",
    "available_datasets"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "species": {
      "type": "string"
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "available_datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "profile_path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "profile_path": {
            "type": "string"
          }
        }
      }
    }
  }
}
