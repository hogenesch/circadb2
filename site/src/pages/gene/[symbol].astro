---
import MainLayout from "@layouts/MainLayout.astro";
import { getGenesIndex } from "@lib/data";

export async function getStaticPaths() {
  const genes = await getGenesIndex();
  return genes.map((gene) => ({
    params: { symbol: gene.slug },
    props: { gene },
  }));
}

const { gene } = Astro.props;
const symbolSlug = gene.slug;
---

<MainLayout title={`${gene.symbol} | CircaDB 2.0`}>
  <section class="space-y-8" data-gene-page data-symbol-slug={symbolSlug}>
    <article class="panel px-6 py-8">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <div class="eyebrow">Canonical Gene</div>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink" data-gene-symbol>
            {gene.symbol}
          </h1>
          <p class="mt-3 text-lg text-slate-700" data-gene-name>{gene.name}</p>
          <div class="mt-6 flex flex-wrap gap-4 text-sm text-slate-600">
            <div>
              <span class="font-semibold text-slate-500">Species:</span>
              <span class="ml-2" data-gene-species>{gene.species}</span>
            </div>
            <div>
              <span class="font-semibold text-slate-500">Aliases:</span>
              <span class="ml-2" data-gene-aliases>{gene.aliases.length ? gene.aliases.join(", ") : "No aliases loaded"}</span>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <label class="eyebrow" for="dataset-select">Dataset</label>
            <select
              id="dataset-select"
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink"
              data-dataset-select
            ></select>
          </div>
          <div>
            <label class="eyebrow" for="algorithm-select">Algorithm</label>
            <select
              id="algorithm-select"
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink"
              data-algorithm-select
            ></select>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Selected dataset</div>
            <p class="mt-2 text-sm font-medium text-ink" data-selected-dataset-title></p>
            <p class="mt-3 text-sm text-slate-600" data-dataset-description></p>
          </div>
        </div>
      </div>
    </article>

    <section class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <article class="panel px-6 py-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="eyebrow">Expression profile</div>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">Time-series plot</h2>
          </div>
          <div class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-600">
            Units: <span class="font-medium text-ink" data-profile-units></span>
          </div>
        </div>
        <div class="mt-6 min-h-[24rem]" data-plot></div>
      </article>

      <aside class="space-y-6">
        <section class="panel px-6 py-8">
          <div class="eyebrow">Rhythmic summary</div>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">Selected algorithm metrics</h2>
          <p class="mt-3 text-sm text-slate-600" data-algorithm-note></p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {[
              ["phase", "Phase"],
              ["amplitude", "Amplitude"],
              ["period", "Period"],
              ["p_value", "P-value"],
              ["q_value", "Q-value"],
              ["rhythmic", "Rhythmic"],
            ].map(([metric, label]) => (
              <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">{label}</div>
                <div class="metric-value mt-2" data-metric={metric}>—</div>
              </div>
            ))}
          </div>
        </section>

        <section class="panel px-6 py-8">
          <div class="eyebrow">Identifiers</div>
          <div class="mt-5 grid gap-3" data-identifiers></div>
        </section>
      </aside>
    </section>

    <section class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="panel px-6 py-8">
        <div class="eyebrow">Dataset metadata</div>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">Observation context</h2>
        <div class="mt-5 grid gap-3" data-dataset-metadata></div>
        <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Citation</div>
          <p class="mt-2 text-sm leading-6 text-ink" data-dataset-citation></p>
        </div>
      </article>

      <article class="panel px-6 py-8">
        <div class="eyebrow">Downloads</div>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">Files and records</h2>
        <ul class="mt-6 flex flex-wrap gap-3" data-downloads></ul>
      </article>
    </section>
  </section>

  <script>
    import { mountGenePage } from "@lib/gene-page";

    const genePage = document.querySelector<HTMLElement>("[data-gene-page]");
    const currentSymbolSlug = genePage?.dataset.symbolSlug;

    if (currentSymbolSlug) {
      void mountGenePage({ symbolSlug: currentSymbolSlug });
    }
  </script>
</MainLayout>
