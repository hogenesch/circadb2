---
import MainLayout from "@layouts/MainLayout.astro";
import { ALGORITHM_META, ALGORITHM_ORDER } from "@lib/algorithms";
import { getDatasetsIndex } from "@lib/data";

const datasets = await getDatasetsIndex();
---

<MainLayout title="Search | CircaDB 2.0">
  <section class="mb-8 panel px-6 py-8">
    <div class="eyebrow">Search</div>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">Gene lookup and criteria search</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-700">
      Use direct lookup when you know a gene symbol, alias, or probe ID. Use criteria search to
      find sets of Hughes 2009 liver genes matching rhythmicity thresholds such as
      <span class="font-mono">JTK q &lt; 0.001</span>.
    </p>
  </section>

  <section class="space-y-8" data-search-page>
    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <article class="panel px-6 py-8">
        <div class="eyebrow">Find A Gene</div>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">Direct gene lookup</h2>
        <p class="mt-3 text-sm text-slate-600">
          Exact symbol, alias, or probe-ID matches open the canonical gene page directly. Other
          queries return a compact match list.
        </p>

        <form class="mt-6 flex flex-col gap-3 sm:flex-row" data-gene-lookup-form>
          <input
            class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-base text-ink outline-none transition placeholder:text-slate-400 focus:border-sea/50"
            type="search"
            placeholder="PER2, Arntl, 1417602_at"
            autocomplete="off"
            data-gene-lookup-input
          />
          <button
            class="rounded-2xl bg-ink px-5 py-3 text-sm font-semibold text-white transition hover:bg-slateblue"
            type="submit"
          >
            Find gene
          </button>
        </form>

        <ul class="mt-4 space-y-2" data-gene-lookup-results></ul>
      </article>

      <article class="panel px-6 py-8" id="criteria-search">
        <div class="eyebrow">Find Gene Sets</div>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">Search by rhythmicity criteria</h2>
        <p class="mt-3 text-sm text-slate-600">
          Static client-side filtering against a compact Hughes 2009 JTK index.
        </p>

        <form class="mt-6 grid gap-4 md:grid-cols-2" data-criteria-form>
          <label class="block">
            <span class="eyebrow">Dataset</span>
            <select
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink"
              data-criteria-dataset
            >
              {datasets.map((dataset) => (
                <option value={dataset.id}>{dataset.title}</option>
              ))}
            </select>
          </label>

          <label class="block">
            <span class="eyebrow">Algorithm</span>
            <select
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink"
              data-criteria-algorithm
            >
              {ALGORITHM_ORDER.map((algorithmId) => (
                <option value={algorithmId} disabled={algorithmId !== "jtk_cycle"}>
                  {algorithmId === "jtk_cycle"
                    ? ALGORITHM_META[algorithmId].label
                    : `${ALGORITHM_META[algorithmId].label} (not loaded)`}
                </option>
              ))}
            </select>
          </label>

          <label class="block">
            <span class="eyebrow">Q-value cutoff</span>
            <input
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-sea/50"
              type="number"
              min="0"
              max="1"
              step="0.0001"
              value="0.001"
              data-criteria-q
            />
          </label>

          <label class="block">
            <span class="eyebrow">Rhythmic</span>
            <select
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink"
              data-criteria-rhythmic
            >
              <option value="yes">Yes</option>
              <option value="no">No</option>
            </select>
          </label>

          <label class="block">
            <span class="eyebrow">Phase Min</span>
            <input
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-sea/50"
              type="number"
              step="0.1"
              placeholder="Optional"
              data-criteria-phase-min
            />
          </label>

          <label class="block">
            <span class="eyebrow">Phase Max</span>
            <input
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-sea/50"
              type="number"
              step="0.1"
              placeholder="Optional"
              data-criteria-phase-max
            />
          </label>

          <div class="md:col-span-2 flex flex-wrap gap-3 pt-2">
            <button
              class="rounded-full bg-sea px-5 py-3 text-sm font-semibold text-white hover:bg-ink"
              type="submit"
            >
              Apply filters
            </button>
            <button
              class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 hover:border-sea/40 hover:text-sea"
              type="button"
              data-criteria-reset
            >
              Reset filters
            </button>
          </div>
        </form>
      </article>
    </div>

    <section class="panel px-6 py-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="eyebrow">Results</div>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">Criteria matches</h2>
        </div>
        <div class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-600" data-criteria-summary>
          0 hits
        </div>
      </div>

      <div class="mt-6 overflow-x-auto">
        <table class="min-w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500">
              <th class="px-4 py-3 font-semibold">Symbol</th>
              <th class="px-4 py-3 font-semibold">Name</th>
              <th class="px-4 py-3 font-semibold">Phase</th>
              <th class="px-4 py-3 font-semibold">Amplitude</th>
              <th class="px-4 py-3 font-semibold">Q-value</th>
              <th class="px-4 py-3 font-semibold">Rhythmic</th>
              <th class="px-4 py-3 font-semibold">Gene page</th>
            </tr>
          </thead>
          <tbody data-criteria-rows></tbody>
        </table>
        <p class="mt-4 hidden rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-500" data-criteria-empty>
          No genes matched the current criteria.
        </p>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="text-sm text-slate-500" data-page-label>Page 1 of 1</div>
        <div class="flex gap-3">
          <button
            class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 disabled:cursor-not-allowed disabled:opacity-40"
            type="button"
            data-prev-page
          >
            Previous
          </button>
          <button
            class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 disabled:cursor-not-allowed disabled:opacity-40"
            type="button"
            data-next-page
          >
            Next
          </button>
        </div>
      </div>
    </section>
  </section>

  <script>
    import { mountSearchPage } from "@lib/search-page";

    const root = document.querySelector<HTMLElement>("[data-search-page]");
    if (root) {
      void mountSearchPage(root);
    }
  </script>
</MainLayout>
