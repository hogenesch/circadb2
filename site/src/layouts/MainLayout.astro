---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "CircaDB 2.0 proof of concept: a static scientific data viewer for circadian gene-expression datasets.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="mx-auto min-h-screen max-w-7xl px-4 pb-16 pt-6 sm:px-6 lg:px-8">
      <header class="panel mb-8 overflow-hidden">
        <div class="flex flex-col gap-4 border-b border-slate-200/80 bg-gradient-to-r from-white via-white to-sea/10 px-6 py-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <a href={import.meta.env.BASE_URL} class="text-2xl font-semibold tracking-tight text-ink">
              CircaDB 2.0
            </a>
            <p class="mt-2 max-w-2xl text-sm text-slate-600">
              Static scientific data viewer for canonical genes, datasets, and dataset-specific rhythmic profiles.
            </p>
          </div>
          <nav class="flex gap-3 text-sm font-medium">
            <a
              class="rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-700 hover:border-sea/40 hover:text-sea"
              href={import.meta.env.BASE_URL}
            >
              Home
            </a>
            <a
              class="rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-700 hover:border-sea/40 hover:text-sea"
              href={`${import.meta.env.BASE_URL}datasets`}
            >
              Datasets
            </a>
            <a
              class="rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-700 hover:border-sea/40 hover:text-sea"
              href={`${import.meta.env.BASE_URL}search`}
            >
              Search
            </a>
          </nav>
        </div>
        <div class="grid gap-4 px-6 py-4 text-xs text-slate-500 sm:grid-cols-3">
          <div>
            <div class="eyebrow">Model</div>
            <p class="mt-2">Gene, Dataset, and GeneDatasetProfile are separate from the beginning.</p>
          </div>
          <div>
            <div class="eyebrow">Runtime</div>
            <p class="mt-2">Static files only. Runtime reads precomputed JSON from <code class="font-mono">public_data/</code>.</p>
          </div>
          <div>
            <div class="eyebrow">Algorithms</div>
            <p class="mt-2">Schema supports JTK_CYCLE, eJTK, Lomb-Scargle, ARSER, RAIN, and MetaCycle.</p>
          </div>
        </div>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
