---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Find a gene",
  description = "Search by gene symbol, alias, or probe ID. Exact matches open the canonical gene page; other queries fall through to the full search view.",
} = Astro.props;
---

<section class="panel px-6 py-6" data-search-root>
  <div class="max-w-3xl">
    <div class="eyebrow">Gene Search</div>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">{title}</h2>
    <p class="mt-2 text-sm text-slate-600">{description}</p>
  </div>

  <form class="mt-6 flex flex-col gap-3 sm:flex-row" data-search-form>
    <input
      class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-base text-ink outline-none ring-0 transition placeholder:text-slate-400 focus:border-sea/50"
      type="search"
      name="gene"
      placeholder="Search by gene symbol, alias, or probe ID"
      autocomplete="off"
      data-search-input
    />
    <button
      class="rounded-2xl bg-ink px-5 py-3 text-sm font-semibold text-white transition hover:bg-slateblue"
      type="submit"
    >
      Open gene
    </button>
  </form>

  <ul class="mt-4 space-y-2" data-search-results></ul>
</section>

<script>
  import { mountSearchBox } from "../lib/search";

  document.querySelectorAll("[data-search-root]").forEach((root) => {
    mountSearchBox(root as HTMLElement);
  });
</script>
